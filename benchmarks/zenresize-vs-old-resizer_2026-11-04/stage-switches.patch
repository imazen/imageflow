diff -ruN '--exclude=old_lut.rs' '--exclude=target' '--exclude=Cargo.lock' zr-clean/src/lib.rs zenresize/src/lib.rs
--- zr-clean/src/lib.rs	2026-04-23 02:03:19.000000000 -0600
+++ zenresize/src/lib.rs	2026-11-04 18:21:38.924117115 -0700
@@ -93,3 +93,27 @@
 
 // Re-export whereat types for downstream consumers
 pub use whereat::{At, ResultAtExt};
+
+// resize-why experiment: swap one stage of the float path for the code imageflow had before bc752d9f.
+#[allow(dead_code)]
+mod old_lut;
+pub(crate) mod oldstage {
+    pub(crate) fn on(name: &str) -> bool { std::env::var_os(name).is_some() }
+    pub(crate) fn decode_table() -> &'static [f32; 256] {
+        static T: std::sync::OnceLock<[f32; 256]> = std::sync::OnceLock::new();
+        T.get_or_init(|| {
+            let mut t = [0f32; 256];
+            for n in 0..256 {
+                let s: f32 = n as u8 as f32 * (1.0f32 / 255.0f32);
+                t[n] = if s <= 0.04045f32 { s / 12.92f32 } else { f32::powf((s + 0.055f32) / (1_f32 + 0.055f32), 2.4f32) };
+            }
+            t
+        })
+    }
+    pub(crate) fn encode(v: f32) -> u8 { crate::old_lut::linear_to_srgb_lut(v) }
+    pub(crate) fn alpha(clr: f32) -> u8 {
+        let mut result: u16 = (clr as f64 + 0.5f64) as i16 as u16;
+        if result as i32 > 255_i32 { result = if clr < 0_i32 as f32 { 0_i32 } else { 255_i32 } as u16 }
+        result as u8
+    }
+}
